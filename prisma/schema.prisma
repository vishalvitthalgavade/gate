generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVISION
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum SessionType {
  POMODORO_WORK
  POMODORO_SHORT_BREAK
  POMODORO_LONG_BREAK
  TIMER
  STOPWATCH
}

enum RevisionKind {
  LEARNED
  REVISION_1
  REVISION_2
  REVISION_3
  PYQ
  MOCK_TEST
}

enum GoalKind {
  DAILY_STUDY_MINUTES
  DAILY_POMODOROS
  DAILY_QUESTIONS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings         Settings?
  subjects         Subject[]
  topics           Topic[]
  studySessions    StudySession[]
  dailyActivities  DailyActivity[]
  goals            Goal[]
  revisions        Revision[]
  achievements     UserAchievement[]

  @@index([email])
}

model Settings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  examDate               DateTime @db.Date
  preparationStartDate   DateTime @db.Date
  timezone               String   @default("Asia/Kolkata")
  dailyStudyGoalMinutes  Int      @default(300)
  dailyPomodoroGoal      Int      @default(8)
  dailyQuestionGoal      Int      @default(50)
  streakMinMinutes       Int      @default(1)
  soundEnabled           Boolean  @default(true)
  volume                 Int      @default(80)
  completionSound        String   @default("classic-bell")
  countdownSoundEnabled  Boolean  @default(false)
  pomodoroWorkMinutes    Int      @default(25)
  pomodoroShortBreak     Int      @default(5)
  pomodoroLongBreak      Int      @default(15)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subject {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  priority    Priority  @default(MEDIUM)
  targetDate  DateTime? @db.Date
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics        Topic[]
  studySessions StudySession[]
  revisions     Revision[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, sortOrder])
}

model Topic {
  id              String      @id @default(cuid())
  userId          String
  subjectId       String
  name            String
  description     String?
  status          TopicStatus @default(NOT_STARTED)
  completedAt     DateTime?
  revisionStatus  Boolean     @default(false)
  priority        Priority    @default(MEDIUM)
  notes           String?
  targetDate      DateTime?   @db.Date
  questionsSolved Int         @default(0)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studySessions StudySession[]
  revisions     Revision[]

  @@unique([subjectId, name])
  @@index([userId])
  @@index([subjectId])
  @@index([userId, status])
}

model StudySession {
  id              String      @id @default(cuid())
  userId          String
  subjectId       String?
  topicId         String?
  durationSeconds Int
  sessionType     SessionType
  startedAt       DateTime
  endedAt         DateTime
  completed       Boolean     @default(true)
  createdAt       DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startedAt])
  @@index([subjectId])
  @@index([topicId])
}

model DailyActivity {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  totalStudyMinutes Int     @default(0)
  pomodoros        Int      @default(0)
  completedTopics  Int      @default(0)
  questionsSolved  Int      @default(0)
  goalCompleted    Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  kind        GoalKind
  targetValue Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

model Revision {
  id          String       @id @default(cuid())
  userId      String
  subjectId   String
  topicId     String
  kind        RevisionKind
  completed   Boolean      @default(false)
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, kind])
  @@index([userId])
  @@index([topicId])
  @@index([subjectId])
  @@index([userId, dueDate])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}
