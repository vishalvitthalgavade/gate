generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


/*
====================================================
USER
====================================================
*/

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studySessions    StudySession[]
  completedTopics  CompletedTopic[]
  pomodoroSettings PomodoroSettings?
  authSessions     AuthSession[]

  @@map("users")
}


/*
====================================================
STUDY SESSION
====================================================
*/

model StudySession {
  id       String @id @default(cuid())
  clientId String @unique

  userId String

  subject  String
  topic    String
  duration Int
  type     String

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])

  @@map("study_sessions")
}


/*
====================================================
COMPLETED SYLLABUS TOPIC
====================================================
*/

model CompletedTopic {
  id String @id @default(cuid())

  userId String

  subject String
  unit    String
  topic   String

  completed   Boolean  @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, unit, topic])
  @@index([userId])

  @@map("completed_topics")
}


/*
====================================================
POMODORO SETTINGS
====================================================
*/

model PomodoroSettings {
  id String @id @default(cuid())

  userId String @unique

  study                   Int @default(25)
  shortBreak              Int @default(5)
  longBreak               Int @default(15)
  sessionsBeforeLongBreak Int @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pomodoro_settings")
}


/*
====================================================
AUTH SESSION
====================================================
*/

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("auth_sessions")
}