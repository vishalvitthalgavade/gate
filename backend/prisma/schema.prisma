generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


/*
====================================================
USER
====================================================
*/

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studySessions    StudySession[]
  activeStudy      ActiveStudySession?
  completedTopics  CompletedTopic[]
  pomodoroSettings PomodoroSettings?
  authSessions     AuthSession[]

  @@map("users")
}


/*
====================================================
STUDY SESSION
====================================================
*/

model StudySession {
  id       String @id @default(cuid())
  clientId String @unique

  userId String

  subject  String
  topic    String
  duration Int
  type     String

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])

  @@map("study_sessions")
}


/*
====================================================
ACTIVE STUDY SESSION
====================================================

Stores the timer that is currently running.

This is separate from StudySession so an active
timer does not appear in History/Statistics until
the student actually saves/completes it.

Only one active timer is allowed per user.
====================================================
*/

model ActiveStudySession {
  id String @id @default(cuid())

  userId String @unique

  subject String
  topic   String
  type    String

  startedAt DateTime
  pausedAt  DateTime?

  accumulatedSeconds Int @default(0)

  isRunning Boolean @default(true)

  lastHeartbeatAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([isRunning])
  @@index([lastHeartbeatAt])

  @@map("active_study_sessions")
}


/*
====================================================
COMPLETED SYLLABUS TOPIC
====================================================
*/

model CompletedTopic {
  id String @id @default(cuid())

  userId String

  subject String
  unit    String
  topic   String

  completed   Boolean  @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, unit, topic])
  @@index([userId])

  @@map("completed_topics")
}


/*
====================================================
POMODORO SETTINGS
====================================================
*/

model PomodoroSettings {
  id String @id @default(cuid())

  userId String @unique

  study                   Int @default(25)
  shortBreak              Int @default(5)
  longBreak               Int @default(15)
  sessionsBeforeLongBreak Int @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pomodoro_settings")
}


/*
====================================================
AUTH SESSION
====================================================
*/

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("auth_sessions")
}